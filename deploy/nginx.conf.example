# Merge into the existing TLS vhost only after inspecting the server config.
# Preserve the existing certificate management and unrelated location blocks.
# This snippet belongs inside the HTTPS server for arena.kpd100.site.
location / {
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 15s;
}
